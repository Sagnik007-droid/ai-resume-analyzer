# Backend environment variables
PORT=5000
NODE_ENV=development
DATABASE_URL=your_postgresql_connection_string
# Generate a random secret of at least 32 characters; never commit the real value.
AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_characters
GEMINI_API_KEY=your_gemini_api_key
NVIDIA_API_KEY=your_nvidia_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# Comma-separated allowed frontend origins. Add your exact deployed frontend URL.
FRONTEND_URL=http://localhost:5173
